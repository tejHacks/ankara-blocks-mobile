{
  "expo": {
    "name": "Ankara Blocks",
    "slug": "ankara-blocks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ankarablocks",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.olateju.ankarablocks",
      "supportsTablet": true
    },
    "android": {
      "package": "com.olateju.ankarablocks",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#BE123C"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#BE123C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}